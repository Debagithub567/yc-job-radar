# Local Postgres connection. Start Postgres before running db:migrate.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Capture a current search-only key from your own Work at a Startup jobs
# browser request. The key in an old checkout may have expired.
ALGOLIA_APP_ID=45BWZJ1SGC
ALGOLIA_SEARCH_KEY=replace_with_current_search_key
ALGOLIA_INDEX=WaaSPublicCompanyJob_company_most_active_production

# Create your own key at https://aistudio.google.com/apikey
GEMINI_API_KEY=replace_with_your_gemini_key
EXTRACTION_MODEL=gemini-3.6-flash

ALGOLIA_REQUEST_DELAY_MS=400
